---
import { Icon } from 'astro-icon';
import { socials } from '../data/socials';
---

<ul class="social__list">
  {
    socials.map((social) => (
      <li>
        <a href={social.url} aria-label={`Mở ${social.name}`} title={`Mở ${social.name}`} rel="me">
          <Icon name={social.icon} width="20px" height="20px" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social__list {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social__list li {
    display: flex;
    align-items: center;
  }

  .social__list li a {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .social__list li a:hover {
    opacity: 0.75;
    transform: translateY(-1px);
  }
</style>
