---
import 'katex/dist/katex.min.css';
import Layout from './Page.astro';
import Container from '../components/Container.astro';
import CategoryLink from '../components/CategoryLink.astro';
import PostImage from '../components/PostImage.astro';
import ArticleToc from '../components/ArticleToc.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { settings } from '../data/settings';
import { formatDate, getReadingTime, slugify, withBase } from '../utils/helpers';
import { getRelatedPosts } from '../utils/posts';
import { allPosts } from '../utils/content.js';
import { getInitials } from '../lib/initials';
import { and, eq } from 'drizzle-orm';
import { db } from '../lib/db';
import { savedPosts } from '../lib/db/schema';

const { frontmatter, headings = [] } = Astro.props;
const rawContent = typeof Astro.props.rawContent === 'function' ? Astro.props.rawContent() : '';
const readingMinutes = rawContent ? getReadingTime(rawContent) : null;
const secondaryHeadings = headings.filter((heading) => heading.depth === 3);
const toc = headings.some((heading) => heading.depth === 2)
  ? headings.filter((heading) => heading.depth === 2)
  : secondaryHeadings;
const related = getRelatedPosts(allPosts, Astro.props.file ?? Astro.url.pathname, frontmatter.category, 2);
const categoryUrl = frontmatter.category
  ? withBase(`/blog/category/${slugify(frontmatter.category)}`)
  : null;
const shareUrl = new URL(Astro.url.pathname, settings.site).href;
const shareText = encodeURIComponent(frontmatter.title);
const postPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const user = Astro.locals.user;
const isSaved = user
  ? (await db
      .select({ id: savedPosts.id })
      .from(savedPosts)
      .where(and(eq(savedPosts.userId, user.id), eq(savedPosts.postSlug, postPath)))
      .limit(1)).length > 0
  : false;
const initials = getInitials(settings.author);

const seo = {
  title: `${frontmatter.title} — ${settings.name}`,
  description: frontmatter.description,
  image: frontmatter.image,
};
---

<Layout seo={seo}>
  <div class="post-wide">
    <Container>
      <article class="post">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={withBase('/')}>Trang chủ</a>
          <span aria-hidden="true">/</span>
          {categoryUrl && <a href={categoryUrl}>{frontmatter.category}</a>}
          {categoryUrl && <span aria-hidden="true">/</span>}
          <span aria-current="page">Bài viết</span>
        </nav>

        <section class:list={['post-split', !frontmatter.image && 'post-split--no-cover']}>
          <header class="post-header">
            <div class="post-kicker">
              {frontmatter.category && <CategoryLink category={frontmatter.category} />}
              <span class="post-kicker__text">Bài viết</span>
            </div>
            <h1 class="post-title">{frontmatter.title}</h1>
            {frontmatter.description && <p class="post-lead">{frontmatter.description}</p>}
            <div class="post-meta">
              <span class="author"><span class="avatar">{initials}</span>{settings.author}</span>
              <span class="meta-sep" aria-hidden="true"></span>
              <time datetime={frontmatter.publishedAt}>{formatDate(frontmatter.publishedAt)}</time>
              {
                readingMinutes && (
                  <>
                    <span class="meta-sep" aria-hidden="true"></span>
                    <span>{readingMinutes} phút đọc</span>
                  </>
                )
              }
              <span class="meta-spacer"></span>
              {user ? (
                <button
                  class="save-btn"
                  type="button"
                  data-save-post
                  data-post-title={frontmatter.title}
                  data-post-url={postPath}
                  aria-pressed={isSaved}
                >
                  {isSaved ? 'Đã lưu' : 'Lưu bài'}
                </button>
              ) : (
                <a class="save-btn" href={withBase(`/dang-nhap?next=${encodeURIComponent(postPath)}`)}>
                  Lưu bài
                </a>
              )}
            </div>
          </header>

          {
            frontmatter.image && (
              <figure class="post-cover">
                <PostImage
                  image={frontmatter.image}
                  alt={frontmatter.alt || frontmatter.title}
                  width={1200}
                  height={800}
                  loading="eager"
                  class="post-cover__img"
                />
                {(frontmatter.imageCaption || frontmatter.alt) && (
                  <figcaption>{frontmatter.imageCaption || frontmatter.alt}</figcaption>
                )}
              </figure>
            )
          }
        </section>

        <div class="reader-bar">
          <div class="reader-inner">
            <span class="progress-label">Tiến độ</span>
            <div class="progress" aria-hidden="true"><span data-reading-progress></span></div>
            <div class="reader-share">
              <a
                class="share-btn"
                href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${shareText}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                X
              </a>
              <button class="share-btn" type="button" data-copy-link>Chép liên kết</button>
              {readingMinutes && <span class="reading-time">{readingMinutes} phút đọc</span>}
            </div>
          </div>
        </div>

        <div class:list={['post-body', !toc.length && 'post-body--full']}>
          {toc.length > 0 && <ArticleToc headings={toc} />}

          <div class="post-main">
            <div class="post-content flow">
              <slot />
            </div>

            <section class="post-author" aria-labelledby="post-author-title">
              <span class="avatar">{initials}</span>
              <div>
                <h2 id="post-author-title">Về tác giả</h2>
                <p>{settings.description}</p>
              </div>
            </section>

            <div class="post-end">
              {
                categoryUrl && (
                  <div class="post-topic">
                    <div>
                      <span>Chủ đề</span>
                      <strong>{frontmatter.category}</strong>
                    </div>
                    <a href={categoryUrl}>Xem tất cả bài viết →</a>
                  </div>
                )
              }

              {related.length > 0 && <RelatedPosts posts={related} />}

              <a class="back-top" href="#main">↑ Quay lại đầu trang</a>
            </div>
          </div>
        </div>
      </article>
    </Container>
  </div>
</Layout>

<script>
  const progressBars = [...document.querySelectorAll<HTMLElement>('[data-reading-progress]')];
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const sections = tocLinks
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((section): section is HTMLElement => section !== null);

  const updateProgress = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const percent = max > 0 ? Math.min(100, Math.max(2, (window.scrollY / max) * 100)) : 100;
    progressBars.forEach((bar) => {
      bar.style.width = `${percent}%`;
    });
  };

  const updateToc = () => {
    if (!sections.length) return;
    const marker = 180;
    let active: HTMLElement = sections[0];

    for (const section of sections) {
      if (section.getBoundingClientRect().top <= marker) active = section;
      else break;
    }

    tocLinks.forEach((link) => {
      if (decodeURIComponent(link.hash.slice(1)) === active.id) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  const onScroll = () => {
    updateProgress();
    updateToc();
  };

  updateProgress();
  updateToc();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);

  const saveBtn = document.querySelector<HTMLButtonElement>('[data-save-post]');
  if (saveBtn) {
    const syncSaveButton = (isSaved: boolean) => {
      saveBtn.setAttribute('aria-pressed', String(isSaved));
      saveBtn.textContent = isSaved ? 'Đã lưu' : 'Lưu bài';
    };

    saveBtn.addEventListener('click', async () => {
      if (saveBtn.disabled) return;
      const original = saveBtn.textContent;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Đang lưu…';

      try {
        const response = await fetch('/api/saved-posts', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            postSlug: saveBtn.dataset.postUrl,
            postTitle: saveBtn.dataset.postTitle,
            postUrl: saveBtn.dataset.postUrl,
          }),
        });

        if (response.status === 401) {
          window.location.assign(`/dang-nhap?next=${encodeURIComponent(window.location.pathname)}`);
          return;
        }

        if (!response.ok) throw new Error('save failed');
        const result = await response.json();
        syncSaveButton(Boolean(result.saved));
      } catch {
        saveBtn.textContent = 'Không lưu được';
        window.setTimeout(() => {
          saveBtn.textContent = original;
        }, 1600);
      } finally {
        saveBtn.disabled = false;
      }
    });
  }

  const copyBtn = document.querySelector('[data-copy-link]');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const original = copyBtn.textContent;
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyBtn.textContent = 'Đã chép';
      } catch {
        copyBtn.textContent = 'Không chép được';
      }
      window.setTimeout(() => {
        copyBtn.textContent = original;
      }, 1600);
    });
  }
</script>
