# Local URLs. In production set both to your public origin, for example https://blog.example.com
PUBLIC_SITE_URL=http://localhost:4321
BETTER_AUTH_URL=http://localhost:4321

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Local Docker database from compose.yaml. Use a pooled PostgreSQL URL on Vercel.
DATABASE_URL=postgresql://blog:blog_local_password@localhost:5432/blog

# Required to send password reset and verification emails in production.
# Without RESEND_API_KEY, local development prints links to the console.
RESEND_API_KEY=
EMAIL_FROM=nét mực. <no-reply@example.com>
