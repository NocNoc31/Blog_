---
import Container from './Container.astro';
import SocialList from './SocialList.astro';
import { settings } from '../data/settings';
import { withBase } from '../utils/helpers';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="foot-grid">
      <div>
        <p class="foot-brand"><b>nét mực.</b></p>
        <p class="foot-big">{settings.quoteLead} <span>{settings.quoteTail}</span></p>
      </div>

      <div class="foot-side">
        <nav class="foot-nav" aria-label="Chân trang">
          {settings.nav.map((item) => (
            <a href={withBase(item.href)}>{item.label}</a>
          ))}
        </nav>
        <SocialList />
      </div>
    </div>

    <div class="foot-bottom">
      <p>© {year} {settings.name} · {settings.footerNote}</p>
    </div>
  </Container>
</footer>
