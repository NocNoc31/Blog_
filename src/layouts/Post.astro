<style>
  .post-content__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .post-content__category {
    padding: 0.5rem 1rem;
    font-size: var(--step--1);
    background-color: var(--theme-surface-1);
    border-radius: 2rem;
  }
  .post-content__category a {
    text-decoration: none;
  }
  .post-content__category a:hover {
    opacity: 0.8;
  }
  .post-content__article {
    padding: 5vh 0;
  }
  .post-content__title {
    margin: 1rem auto;
    font-size: var(--step-5);
  }
  .post-content__date {
    margin: 0 auto;
    font-size: var(--step--1);
    color: var(--color-muted);
    font-style: italic;
  }
  .post-content__img {
    margin: 3rem auto;
    max-width: min(100%, 800px); /* Giới hạn chiều rộng ảnh tiêu đề */
    width: 100%;
    height: auto;
    border-radius: 2rem;
    display: block;
  }
  .post-content__content :global(img) {
    max-width: min(100%, 800px); /* Giới hạn chiều rộng ảnh trong nội dung */
    width: 100%;
    height: auto;
    margin: 2rem auto;
    display: block;
    border-radius: 1rem;
  }
  .post-content__content :global(figcaption) {
    text-align: center;
    font-style: italic;
    color: var(--color-muted);
    font-size: 0.9em;
    margin-top: 0.5em;
  }
  .post-content__content :global(.katex-display) {
    display: block;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .post-content__content :global(iframe) {
    max-width: 100%;
  }
  .post-content__content :global(pre) {
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
  }
  .post-content__content :global(a) {
    overflow-wrap: anywhere;
  }
</style>