---
import 'katex/dist/katex.min.css';
import Layout from './Page.astro';
import Container from '../components/Container.astro';
import { formatDate, slugify, withBase } from '../utils/helpers';
import { resolveHeroImage } from '../utils/public-image';

const { frontmatter } = Astro.props;
const hero = resolveHeroImage(frontmatter.image);

// At a phone width the long titles are taller than the hero, so preloading
// the hero only delays that text. Preload when the picture is the larger box.
const contentWidth = 380;
const imageHeight = hero.width ? (contentWidth * hero.height) / hero.width : 0;
const titleLines = Math.ceil(String(frontmatter.title ?? '').trim().length / 17) || 1;
const heroIsLcp = imageHeight >= titleLines * 45 * 1.15;

const seo = {
  title: frontmatter.title,
  description: frontmatter.description,
  image: frontmatter.image,
  lcpImage: heroIsLcp ? hero.webp || hero.src || undefined : undefined,
};
---

<Layout seo={seo}>
  <Container>
    <article class="post-content__article">
      <div class="post-content__top fade-in">
        {
          frontmatter.category && (
            <p class="post-content__category">
              <a href={withBase(`/blog/category/${slugify(frontmatter.category)}`)}>
                {frontmatter.category}
              </a>
            </p>
          )
        }
        <h1 class="post-content__title">{frontmatter.title}</h1>
        <p class="post-content__date">
          <time>{formatDate(frontmatter.publishedAt)}</time>
        </p>
        <!-- Hopefully we'll be able to use Astro's image integration for this soon -->
        {
          hero.src && (
            <picture>
              {hero.webp && <source srcset={withBase(hero.webp)} type="image/webp" />}
              <img
                width={hero.width ?? 1200}
                height={hero.height ?? 630}
                class="post-content__img"
                loading="eager"
                fetchpriority={heroIsLcp ? 'high' : 'low'}
                src={withBase(hero.src)}
                alt={frontmatter.alt || frontmatter.title}
              />
            </picture>
          )
        }
      </div>
      <div class="post-content__content flow fade-in">
        <slot />
      </div>
    </article>
  </Container>
</Layout>

