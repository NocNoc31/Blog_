---
import BlogPostPreview from './BlogPostPreview.astro';

const { posts = [], empty = 'Chưa có bài viết nào.' } = Astro.props;
---

{posts.length === 0 && <p class="empty-state">{empty}</p>}

{
  posts.length > 0 && (
    <ul class="post-grid">
      {posts.map((post) => (
        <li>
          <BlogPostPreview post={post} />
        </li>
      ))}
    </ul>
  )
}
