---
import CategoryLink from './CategoryLink.astro';
import PostImage from './PostImage.astro';
import { formatDate, withBase } from '../utils/helpers';

const { post } = Astro.props;
const { frontmatter } = post;
const url = withBase(post.url);
---

<article class="post-card">
  <a class="card-media" href={url} tabindex="-1" aria-hidden="true">
    <PostImage image={frontmatter.image} alt={frontmatter.alt || ''} />
  </a>
  <div class="card-body">
    <div class="card-top">
      {frontmatter.category ? <CategoryLink category={frontmatter.category} /> : <span />}
      <time class="date" datetime={frontmatter.publishedAt}>{formatDate(frontmatter.publishedAt)}</time>
    </div>
    <h2 class="card-title"><a href={url}>{frontmatter.title}</a></h2>
    {frontmatter.description && <p class="card-excerpt">{frontmatter.description}</p>}
    <div class="card-foot">
      <span class="more">Đọc bài</span>
      <span class="circ" aria-hidden="true">↗</span>
    </div>
  </div>
</article>
