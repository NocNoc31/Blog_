---
import Layout from '../../../layouts/Page.astro';
import Container from '../../../components/Container.astro';
import BlogPostsList from '../../../components/BlogPostsList.astro';
import { settings } from '../../../data/settings';
import { slugify, withBase } from '../../../utils/helpers';
import { allPosts } from '../../../utils/content.js';

const slug = Astro.params.slug;
const posts = allPosts.filter((post) => post.frontmatter.category && slugify(post.frontmatter.category) === slug);
const category = posts[0]?.frontmatter.category;

if (!category) return Astro.redirect(withBase('/#chu-de'));

const seo = {
  title: `${category} — ${settings.name}`,
  description: `Các bài viết trong chủ đề ${category}.`,
};
---

<Layout seo={seo}>
  <Container>
    <header class="page-head">
      <a class="back-link" href={withBase('/#bai-viet')}>← Tất cả bài viết</a>
      <h1>{category}</h1>
      <p>{posts.length} bài viết</p>
    </header>
    <BlogPostsList posts={posts} empty="Chưa có bài viết trong chủ đề này." />
  </Container>
</Layout>
