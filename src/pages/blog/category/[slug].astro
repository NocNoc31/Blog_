---
import Layout from '../../../layouts/Page.astro';
import Container from '../../../components/Container.astro';
import BlogPostsList from '../../../components/BlogPostsList.astro';
import { settings } from '../../../data/settings';
import { slugify, withBase } from '../../../utils/helpers';
import { sortPosts } from '../../../utils/posts';

export async function getStaticPaths() {
  const posts = sortPosts(await Astro.glob('../*.{md,mdx}'));
  const categories = new Map();

  for (const post of posts) {
    const name = post.frontmatter.category;
    if (!name) continue;

    const slug = slugify(name);
    const entry = categories.get(slug) ?? { name, slug, posts: [] };
    entry.posts.push(post);
    categories.set(slug, entry);
  }

  return [...categories.values()].map(({ name, slug, posts }) => ({
    params: { slug },
    props: { category: name, posts },
  }));
}

const { category, posts } = Astro.props;

const seo = {
  title: `${category} — ${settings.name}`,
  description: `Các bài viết trong chủ đề ${category}.`,
};
---

<Layout seo={seo}>
  <Container>
    <header class="page-head">
      <a class="back-link" href={withBase('/#bai-viet')}>← Tất cả bài viết</a>
      <h1>{category}</h1>
      <p>{posts.length} bài viết</p>
    </header>
    <BlogPostsList posts={posts} empty="Chưa có bài viết trong chủ đề này." />
  </Container>
</Layout>
