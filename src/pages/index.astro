---
import Layout from '../layouts/Page.astro';
import Container from '../components/Container.astro';
import BlogPostsList from '../components/BlogPostsList.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import { settings } from '../data/settings';
import { withBase } from '../utils/helpers';
import { getCategories, sortPosts } from '../utils/posts';

const posts = sortPosts(await Astro.glob('./blog/*.{md,mdx}'));
const featured = posts[0];
const rest = posts.slice(1);
const categories = getCategories(posts);

const seo = {
  title: settings.title,
  description: settings.description,
};
---

<Layout seo={seo}>
  <section class="hero">
    <Container>
      <div class="hero-grid">
        <div>
          <p class="hello"><b aria-hidden="true"></b> {settings.tagline}</p>
          <h1>Giữ lại<br />những điều<br /><span class="box">đáng nhớ.</span></h1>
          <p class="lead">
            Một cuốn sổ mở về robot, sách và đời sống. Ghi lại để ký ức không phải tự nhớ một mình.
          </p>
          <div class="manifesto">
            <span>Robot</span>
            <span>Sách</span>
            <span>Đời sống</span>
          </div>
        </div>

        <aside class="note-card" aria-label="Câu nói">
          <h2>Ghi chú hôm nay</h2>
          <p>“{settings.quote}”</p>
          <span class="sign">nét mực.</span>
        </aside>
      </div>
    </Container>
  </section>

  {
    featured && (
      <section class="feature">
        <Container>
          <FeaturedPost post={featured} />
        </Container>
      </section>
    )
  }

  <section class="topics" id="chu-de">
    <Container>
      <div class="index-head">
        <div>
          <h2>Chủ đề</h2>
          <p>Chọn một hướng để đọc tiếp.</p>
        </div>
      </div>
      <div class="topic-grid">
        {
          categories.map((category) => (
            <a class="topic" href={withBase(`/blog/category/${category.slug}`)}>
              <strong>{category.name}</strong>
              <span>{category.count} bài</span>
            </a>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="index" id="bai-viet">
    <Container>
      <div class="index-head">
        <div>
          <h2>Bài viết <span>mới</span></h2>
          <p>{posts.length} ghi chép, cập nhật mỗi khi có điều đáng giữ.</p>
        </div>
        <nav class="mini-filters" aria-label="Lọc theo chủ đề">
          <a href={withBase('/#bai-viet')} aria-current="page">Tất cả</a>
          {
            categories.map((category) => (
              <a href={withBase(`/blog/category/${category.slug}`)}>{category.name}</a>
            ))
          }
        </nav>
      </div>
      <BlogPostsList posts={rest} empty="Chưa có bài viết nào." />
    </Container>
  </section>

  <section class="about" id="gioi-thieu">
    <Container>
      <div class="about-card">
        <p class="kicker">Giới thiệu</p>
        <h2>Một góc nhỏ để ghi lại.</h2>
        <p>
          Mình là Lộc Phạm, viết về robot, sách và những điều nhỏ trong đời sống. Đây là nơi mình giữ lại
          các ghi chép, bài học và câu chuyện đáng nhớ — để sau này không phải tự nhớ một mình.
        </p>
        <div class="about-links">
          <a href={withBase('/#bai-viet')}>Đọc bài viết</a>
          <a href="https://github.com/NocNoc31" rel="me">GitHub</a>
        </div>
      </div>
    </Container>
  </section>
</Layout>
