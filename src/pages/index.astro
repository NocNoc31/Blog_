---
import Layout from '../layouts/Page.astro'
import Container from '../components/Container.astro';
import BlogPostsList from '../components/BlogPostsList.astro';
import {resolveHeroImage} from '../utils/public-image';
import {withBase} from '../utils/helpers';

function readFrontmatter(source) {
	const match = String(source).match(/^---\r?\n([\s\S]*?)\r?\n---/);
	const frontmatter = {};
	if (!match) return frontmatter;
	for (const line of match[1].split('\n')) {
		const splitAt = line.indexOf(':');
		if (splitAt === -1) continue;
		const key = line.slice(0, splitAt).trim();
		let value = line.slice(splitAt + 1).trim();
		if ((value.startsWith("'") && value.endsWith("'")) || (value.startsWith('"') && value.endsWith('"'))) {
			value = value.slice(1, -1);
		}
		frontmatter[key] = value;
	}
	return frontmatter;
}

// Read the markdown as text. Importing the posts pulls the post layout,
// including KaTeX CSS, into this page.
// Astro.glob() was removed in Astro 6.
// Source: https://docs.astro.build/en/guides/upgrade-to/v6/#removed-astroglob
const posts = Object.entries(import.meta.glob('./blog/*.{md,mdx}', { eager: true, query: '?raw', import: 'default' })).map(
	([file, source]) => ({
		url: withBase(`/blog/${file.split('/').pop().replace(/\.mdx?$/, '')}`),
		frontmatter: readFrontmatter(source),
	})
).sort(
	(a, b) => new Date(b.frontmatter.publishedAt).valueOf() - new Date(a.frontmatter.publishedAt).valueOf()
);

const firstHero = resolveHeroImage(posts[0]?.frontmatter?.image);
const seo = {
  title: 'My/ Your/ Our ... World',
  description: 'A simple blog include all world',
  lcpImage: firstHero.card || firstHero.webp || firstHero.src || undefined,
}
---

<style>
  .home-hero-text__container {
    padding: 5vh 0;
  }
  h1 {
    text-align: center;
  }
</style>

<Layout seo={seo}>
  <Container>
    <div class="home-hero-text__container">
      <h1 class="fade-in">WELCOME TO MY BLOG</h1>
    </div>
    <BlogPostsList posts={posts}/>
  </Container>
</Layout>

